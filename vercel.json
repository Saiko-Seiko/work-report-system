{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.3" },
    { "src": "public/assets/**", "use": "@vercel/static" },
    { "src": "public/sw.js", "use": "@vercel/static" },
    { "src": "public/offline.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/sw.js", "dest": "/public/sw.js" },
    { "src": "/offline.html", "dest": "/public/offline.html" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
